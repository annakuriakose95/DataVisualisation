# Removing Duplicates
duplicate_rows = df_crime.duplicated()

# Removing nulls
df_crime.isnull().sum()

# Deleting rows with null values in specific columns
df_crime.dropna(subset=['premise_code','premise_description','victim_sex','victim_descent'], inplace=True)

# Deleting unwanted columns from the dataframe
df_crime=df_crime.drop(['modus_operandi', 'crime_code_1','crime_code_2','crime_code_3','crime_code_4'], axis=1)

# Converting 'date_reported' column to datetime format
df_crime['date_reported'] = pd.to_datetime(df_crime['date_reported'], format='%d/%m/%Y')

# Converting date_occured to datetime (Pandas.to_Datetime — Pandas 2.2.2 Documentation, n.d.)
df_crime['date_occurred'] = pd.to_datetime(df_crime['date_occurred'], format='%d/%m/%Y %H:%M')

# Deleting observations in which the victim age is 0 and only keeping victim's sex male, female, or unknown
df_crime = df_crime[((df_crime['victim_age'] > 0) & (df_crime['victim_sex'] != '-') & (df_crime['victim_sex'] != 'H'))]

# Replace victim_sex values
df_crime['victim_sex'] = df_crime['victim_sex'].replace({'F': 'Female', 'M': 'Male', 'X': 'Unknown'})

# Extracting year and month from 'date_occurred' and keeping it in separate columns 
df_crime.loc[:, 'year'] = df_crime['date_occurred'].dt.year
df_crime.loc[:, 'month'] = df_crime['date_occurred'].dt.month

# Categorising ages to different categories
df_crime.loc[df_crime['victim_age'] < 18, 'age_group'] = 'juvenile'
df_crime.loc[df_crime['victim_age'].between(18,39), 'age_group'] = 'young adult'
df_crime.loc[df_crime['victim_age'].between(40,59), 'age_group'] = 'adult'
df_crime.loc[df_crime['victim_age'] >=60, 'age_group'] = 'old'

